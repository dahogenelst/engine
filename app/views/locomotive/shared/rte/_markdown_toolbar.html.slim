.rte-toolbar

  span.rte-toolbar-group
    a data-markdown-command='bold'
      i.fa.fa-bold
    a data-markdown-command='italic'
      i.fa.fa-italic

  span.rte-toolbar-group
    a data-url=content_assets_path(current_site) data-markdown-command='insertFile'
      i.fa.fa-file-o
    = image_popover
