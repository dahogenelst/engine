.rte-toolbar

  span.rte-toolbar-group
    a data-command='bold'
      i.fa.fa-bold
    a data-command='italic'
      i.fa.fa-italic
    a data-command='underline'
      i.fa.fa-underline
    a data-command='strike'
      i.fa.fa-strikethrough

  - unless inline
    span.rte-toolbar-group
      a data-command='align' data-value='left'
        i.fa.fa-align-left
      a data-command='align' data-value='center'
        i.fa.fa-align-center
      a data-command='align' data-value='right'
        i.fa.fa-align-right
      a data-command='align' data-value='justify'
        i.fa.fa-align-justify

    span.rte-toolbar-group
      a data-command='bullets'
        i.fa.fa-list-ul
      a data-command='numbers'
        i.fa.fa-list-ol
      a.style
        i.fa.fa-paragraph

      .dialog-content style='display: none'
        - %w(h1 h2 h3 h4 h5 h6 p).each do |name|
          a data-command='block' data-value=name = name.upcase
          | &nbsp;
        a data-command='block' data-value='blockquote'
          i.fa.fa-quote-right
        | &nbsp;
        a data-command='block' data-value='pre' Pre

  span.rte-toolbar-group
    a.link
      i.fa.fa-link
    = link_popover
    a data-command='unlink'
      i.fa.fa-unlink

    a.image data-url=content_assets_path(types: 'image')
      i.far.fa-image
    = image_popover

    a.file data-url=content_assets_path
      i.fa.fa-paperclip

    - unless inline
      a.table
        i.fa.fa-table
      = table_popover

      a.edit-table style="display: none"
        i.fa.fa-table

      .dialog-content style='display: none'
        a data-command="mergeCells"
          = t('.table.merge')
        br
        a data-command="addRowBefore"
          = t('.table.insert_row_before')
        br
        a data-command="addRowAfter"
          = t('.table.insert_row_after')
        br
        a data-command="addColumnBefore"
          = t('.table.insert_col_before')
        br
        a data-command="addColumnAfter"
          = t('.table.insert_col_after')
        br
        a data-command="deleteRow"
          = t('.table.delete_row')
        br
        a data-command="deleteColumn"
          = t('.table.delete_col')

  span.rte-toolbar-group
    - unless inline
      a.expand
        i.fa.fa-expand
    a.source
      i.fa.fa-code

.rte-source-notice.alert.alert-warning style='display: none'
  = t('.source_notice', default: 'This text contains HTML the editor would change, so it is shown as source. Saving keeps it as it is.')
  | &nbsp;
  a.edit-visually href='#'
    = t('.source_notice_edit', default: 'Edit visually anyway')
